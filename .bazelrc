common --enable_bzlmod
build --incompatible_default_to_explicit_init_py
build --per_file_copt=external/.*@-w
build --@rules_rust//rust/settings:rustfmt.toml=//server:rustfmt.toml
build --@rules_rust//rust/settings:clippy.toml=//server:clippy.toml
build --@rules_rust//rust/settings:clippy_flag=-Dwarnings


################################################################################
# Consider implementing when doing GitHub Actions / testing at scale           #
# https://fzakaria.com/2024/02/27/hermetic-but-at-what-cost.html               #
################################################################################
# build --nobuild_runfile_links
# build --nolegacy_external_runfiles
# build --strip=never
# test --nobuild_runfile_links
# test --nolegacy_external_runfiles
# test --sandbox_default_allow_network=true
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:lto=fat
build:release --@rules_rust//rust/settings:codegen_units=1
